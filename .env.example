DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scholar_dev
DB_USERNAME=YOUR_DEVELOPMENT_DB_USER
DB_PASSWORD=YOUR_LOCAL_DB_PASSWORD

# Session timeout settings (in seconds)
SESSION_IDLE_SECONDS=1800
SESSION_MAXIMUM_SECONDS=28800
SESSION_RENEWAL_SECONDS=900

# Failed-login rate limits (window in seconds, 60 to 86400)
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_ADDRESS_MAX_FAILURES=20
LOGIN_FAILURE_WINDOW_SECONDS=900

# Maximum thesis PDF upload size in megabytes (1 to 500)
THESIS_PDF_MAX_MB=50
