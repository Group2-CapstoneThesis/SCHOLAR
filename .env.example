# Copy to .env outside public/. Never commit the filled-in file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scholar_dev
DB_USERNAME=YOUR_DEVELOPMENT_DB_USER
DB_PASSWORD=YOUR_LOCAL_DB_PASSWORD

# Interim local-development session timers, in seconds. Still need RDPO approval on these durations.
SESSION_IDLE_SECONDS=1800
SESSION_MAXIMUM_SECONDS=28800
SESSION_RENEWAL_SECONDS=900

# Interim failed-login limits. After this many wrong tries inside the window, login is refused until older tries expire.
# The per-address limit must be at least the per-account limit. Window is in seconds (60 to 86400).
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_ADDRESS_MAX_FAILURES=20
LOGIN_FAILURE_WINDOW_SECONDS=900

# Interim largest thesis PDF upload, in whole megabytes (1 to 500). PHP's own upload limits must be at least this large.
THESIS_PDF_MAX_MB=50

# Optional: where backups are written (full path). Default: the private storage/backups folder.
# Point this at another drive or a network folder, because a backup on the same drive is lost with that drive.
# BACKUP_DIRECTORY=D:\scholar_backups

# Semantic search (M14). All optional; these defaults fit a local machine running Ollama and Qdrant.
# SEARCH_SEMANTIC_ENABLED=true            set to false to use word search only
# SEARCH_OLLAMA_URL=http://127.0.0.1:11434
# SEARCH_EMBEDDING_MODEL=bge-m3
# SEARCH_QDRANT_URL=http://127.0.0.1:6333
# SEARCH_QDRANT_API_KEY=                  set when Qdrant is started with an API key
# SEARCH_QDRANT_COLLECTION=scholar_theses
# SEARCH_MIN_SCORE=0.5                    lowest similarity (0-1) for a match found by meaning only

# AI relevance explanations (OpenRouter). Leave either value empty to show search results without explanations.
# Only the visitor's search query and the thesis ABSTRACT are ever sent to OpenRouter - never a PDF, chapter or other field.
# The key stays on the server; it is never sent to the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
